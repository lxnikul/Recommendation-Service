# Source data — the case datasets are ~2.2 GB and exceed GitHub's 100 MB limit.
# Build the committed subset with: python make_sample.py
*.csv

# ...except the sampled fixture, which is small and makes the repo runnable.
!sample_data/*.csv

# Embedding caches — derived output, ~47 MB, rebuilt by: python embed.py
# Git stores binaries whole rather than diffing them, so every regeneration
# would add another full copy to history permanently.
cache/
*.npz

# Python
__pycache__/
*.py[cod]
*.egg-info/
.Python

# Virtual environments
venv/
.venv/
env/

# Hugging Face model cache, if ever pointed at the repo
.cache/
models/

# Editors / IDEs
.idea/
.vscode/
*.swp

# OS
Thumbs.db
desktop.ini
.DS_Store
